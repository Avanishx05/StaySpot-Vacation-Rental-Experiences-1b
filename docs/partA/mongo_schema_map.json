            "Kitchen",
            "Free Parking"
          ]
        },
        "house_rules": {
          "type": "array<string>",
          "description": "Rules that guests should follow during their stay",
          "example": [
            "No smoking",
            "No pets",
            "Quiet hours 10pm-7am"
          ]
        },
        "accessibility_features": {
          "type": "array<string>",
