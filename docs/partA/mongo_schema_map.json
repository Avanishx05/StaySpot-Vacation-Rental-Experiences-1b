          "type": "ObjectId",
          "description": "MongoDB auto-generated document identifier"
        },
        "property_id": {
          "type": "string",
          "description": "Identifier of the related property",
          "required": true,
          "example": "PROP-001"
        },
        "amenities": {
          "type": "array<string>",
          "description": "List of amenities available at the property",
          "example": [
            "WiFi",
